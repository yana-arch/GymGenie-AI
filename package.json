{
  "name": "gymgenie-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fresh": "vite --open -- /?devMode=true",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:smoke": "vitest --run --reporter=verbose -t '@smoke'",
    "test:p0": "vitest --run --reporter=verbose -t '@p0'",
    "test:p1": "vitest --run --reporter=verbose -t '@p1'",
    "test:p2": "vitest --run --reporter=verbose -t '@p2'",
    "test:p3": "vitest --run --reporter=verbose -t '@p3'",
    "test:critical": "vitest --run --reporter=verbose -t '@smoke|@p0'",
    "test:regression": "vitest --run --reporter=verbose -t '@p1|@p2|@p3'",
    "test:full": "vitest --run",
    "test:validate-tags": "tsx scripts/validate-test-tags.ts",
    "test:tag-report": "tsx scripts/validate-test-tags.ts --report-only",
    "test:coverage-by-priority": "tsx scripts/validate-test-tags.ts --coverage",
    "test:auto-tag": "tsx scripts/auto-tag-tests.ts",
    "cleanup": "tsx analyzers/cli/index.ts",
    "cleanup:analyze": "tsx analyzers/cli/index.ts analyze",
    "cleanup:execute": "tsx analyzers/cli/index.ts cleanup",
    "cleanup:report": "tsx analyzers/cli/index.ts report",
    "cleanup:rollback": "tsx analyzers/cli/index.ts rollback",
    "cleanup:metrics": "tsx analyzers/cli/index.ts metrics",
    "setup:hooks": "./scripts/setup-git-hooks.sh",
    "scheduled:cleanup": "./scripts/scheduled-cleanup.sh",
    "analysis:full": "tsx scripts/run-full-analysis.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@emotion/react": "^11.14.0",
    "@google/genai": "^1.34.0",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@mantine/notifications": "^8.3.12",
    "@reduxjs/toolkit": "^2.11.2",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/react-virtualized": "^9.22.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-redux": "^9.2.0",
    "react-virtualized": "^9.22.6",
    "react-virtualized-auto-sizer": "^2.0.1",
    "react-window": "^2.2.3",
    "react-window-infinite-loader": "^2.0.0",
    "recharts": "^3.6.0",
    "redux-persist": "^6.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@fast-check/vitest": "^0.2.4",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/react-redux": "^7.1.34",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "dependency-cruiser": "^17.3.5",
    "eslint": "^9.39.2",
    "js-yaml": "^4.1.1",
    "jscpd": "^4.0.5",
    "jsdom": "^27.4.0",
    "knip": "^5.79.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
  }
}
